# Planner. Leave GEMINI_API_KEY blank to run entirely offline on the
# deterministic rule planner (this is what CI does).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_S=30

# Where checkpoints and traces live. Checkpoints are what make an interrupted
# run resumable by another process.
CHECKPOINT_DB=data/checkpoints.sqlite
TRACE_DIR=data/traces

# Guardrails. A run stops when it hits any of these ceilings.
MAX_STEPS=25
MAX_TOOL_CALLS=15
MAX_USD=0.50

# Irreversible actions ALWAYS require human approval regardless of this flag.
# This only controls reversible writes, such as drafting a document.
AUTO_APPROVE_REVERSIBLE=true

# Retry policy for tool calls.
DEFAULT_RETRIES=2
DEFAULT_TIMEOUT_S=10
BACKOFF_BASE_S=0.25

# Fault injection, for demonstrating the retry path. Never enable in CI.
FLAKY_TOOLS=false

# Optional tracing export.
LANGSMITH_API_KEY=
